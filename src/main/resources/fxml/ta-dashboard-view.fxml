<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.bupt.tarecruit.controller.TaDashboardController"
            styleClass="root">
    <top>
        <ToolBar>
            <Label fx:id="welcomeLabel" text="TA Console" styleClass="h6"/>
            <Pane HBox.hgrow="ALWAYS"/>
            <Button fx:id="authButton" text="Log out" onAction="#handleAuthAction"/>
        </ToolBar>
    </top>
    <center>
        <TabPane fx:id="tabPane" tabClosingPolicy="UNAVAILABLE">
            <Tab fx:id="myApplicationsTab" text="My applications">
                <BorderPane>
                    <center>
                        <TableView fx:id="applicationTable">
                            <columns>
                                <TableColumn text="Application ID" prefWidth="100">
                                    <cellValueFactory>
                                        <PropertyValueFactory property="applyId"/>
                                    </cellValueFactory>
                                </TableColumn>
                                <TableColumn text="Job title" prefWidth="180">
                                    <cellValueFactory>
                                        <PropertyValueFactory property="jobName"/>
                                    </cellValueFactory>
                                </TableColumn>
                                <TableColumn text="Module" prefWidth="100">
                                    <cellValueFactory>
                                        <PropertyValueFactory property="moduleName"/>
                                    </cellValueFactory>
                                </TableColumn>
                                <TableColumn text="Job Period" prefWidth="140">
                                    <cellValueFactory>
                                        <PropertyValueFactory property="jobPeriod"/>
                                    </cellValueFactory>
                                </TableColumn>
                                <TableColumn text="Status" prefWidth="85">
                                    <cellValueFactory>
                                        <PropertyValueFactory property="statusLabel"/>
                                    </cellValueFactory>
                                </TableColumn>
                                <TableColumn text="Hired Time" prefWidth="120">
                                    <cellValueFactory>
                                        <PropertyValueFactory property="hiredTime"/>
                                    </cellValueFactory>
                                </TableColumn>
                            </columns>
                        </TableView>
                    </center>
                    <bottom>
                        <HBox spacing="10" alignment="CENTER_RIGHT" styleClass="p-3">
                            <Button fx:id="withdrawButton" text="Withdraw" onAction="#handleWithdraw"/>
                        </HBox>
                    </bottom>
                </BorderPane>
            </Tab>
            <Tab fx:id="browseJobsTab" text="Browse jobs">
                <BorderPane>
                    <center>
                        <SplitPane fx:id="browseJobsVerticalSplit" orientation="VERTICAL" dividerPositions="0.62">
                            <BorderPane>
                                <top>
                                    <HBox spacing="10" styleClass="p-3">
                                        <TextField fx:id="jobSearchField" promptText="Search title, module, requirements" HBox.hgrow="ALWAYS" styleClass="search-field"/>
                                        <Button text="Refresh" onAction="#handleRefreshJobs"/>
                                    </HBox>
                                </top>
                                <center>
                                    <SplitPane fx:id="browseJobsHorizontalSplit" dividerPositions="0.5">
                                        <TableView fx:id="jobTable">
                                            <columns>
                                                <TableColumn text="Job ID" prefWidth="90">
                                                    <cellValueFactory>
                                                        <PropertyValueFactory property="jobId"/>
                                                    </cellValueFactory>
                                                </TableColumn>
                                                <TableColumn text="Title" prefWidth="180">
                                                    <cellValueFactory>
                                                        <PropertyValueFactory property="jobName"/>
                                                    </cellValueFactory>
                                                </TableColumn>
                                                <TableColumn text="Module" prefWidth="110">
                                                    <cellValueFactory>
                                                        <PropertyValueFactory property="moduleName"/>
                                                    </cellValueFactory>
                                                </TableColumn>
                                                <TableColumn text="Posted by" prefWidth="100">
                                                    <cellValueFactory>
                                                        <PropertyValueFactory property="moName"/>
                                                    </cellValueFactory>
                                                </TableColumn>
                                                <TableColumn text="Positions" prefWidth="65">
                                                    <cellValueFactory>
                                                        <PropertyValueFactory property="numberOfPositions"/>
                                                    </cellValueFactory>
                                                </TableColumn>
                                                <TableColumn text="Applicants" prefWidth="70">
                                                    <cellValueFactory>
                                                        <PropertyValueFactory property="applicantsCount"/>
                                                    </cellValueFactory>
                                                </TableColumn>
                                                <TableColumn text="Hired" prefWidth="55">
                                                    <cellValueFactory>
                                                        <PropertyValueFactory property="hiredCount"/>
                                                    </cellValueFactory>
                                                </TableColumn>
                                            </columns>
                                        </TableView>
                                        <ScrollPane fitToWidth="true" hbarPolicy="NEVER">
                                            <content>
                                                <VBox spacing="12" styleClass="detail-panel">
                                                    <padding>
                                                        <Insets top="16" right="16" bottom="16" left="16"/>
                                                    </padding>
                                                    <Label text="Job details" styleClass="h5"/>
                                                    <VBox spacing="2">
                                                        <Label text="Title" styleClass="text-muted"/>
                                                        <Label fx:id="jobNameLabel" styleClass="h6" wrapText="true"/>
                                                    </VBox>
                                                    <VBox spacing="2">
                                                        <Label text="Posted by" styleClass="text-muted"/>
                                                        <Label fx:id="jobMoNameLabel" styleClass="h6" wrapText="true"/>
                                                    </VBox>
                                                    <HBox spacing="20">
                                                        <VBox spacing="2">
                                                            <Label text="Module" styleClass="text-muted"/>
                                                            <Label fx:id="jobModuleLabel"/>
                                                        </VBox>
                                                        <VBox spacing="2">
                                                            <Label text="Positions" styleClass="text-muted"/>
                                                            <Label fx:id="jobPositionsLabel"/>
                                                        </VBox>
                                                    </HBox>
                                                    <VBox spacing="2">
                                                        <Label text="Dates" styleClass="text-muted"/>
                                                        <Label fx:id="jobDateLabel"/>
                                                    </VBox>
                                                    <VBox spacing="4">
                                                        <Label text="Requirements" styleClass="text-muted"/>
                                                        <TextArea fx:id="jobRequirementsArea" editable="false" wrapText="true" prefRowCount="5"/>
                                                    </VBox>
                                                    <VBox spacing="4">
                                                        <Label text="Notes" styleClass="text-muted"/>
                                                        <TextArea fx:id="jobNotesArea" editable="false" wrapText="true" prefRowCount="3"/>
                                                    </VBox>
                                                    <VBox spacing="4">
                                                        <Label text="Keywords" styleClass="text-muted"/>
                                                        <TextArea fx:id="jobKeywordsArea" editable="false" wrapText="true" prefRowCount="2"/>
                                                    </VBox>
                                                    <VBox spacing="4">
                                                        <Label text="AI Resume Optimization Advice" styleClass="text-muted"/>
                                                        <TextArea fx:id="aiResumeAdviceArea" editable="false" wrapText="true" prefRowCount="5"/>
                                                    </VBox>
                                                    <Button text="Generate AI Resume Advice" onAction="#handleAiResumeOptimization" maxWidth="Infinity"/>
                                                    <Button fx:id="applyButton" text="Apply" onAction="#handleApply" styleClass="btn-primary" maxWidth="Infinity"/>
                                                </VBox>
                                            </content>
                                        </ScrollPane>
                                    </SplitPane>
                                </center>
                            </BorderPane>
                            <VBox spacing="6" styleClass="p-3">
                                <padding>
                                    <Insets top="10" right="10" bottom="10" left="10"/>
                                </padding>
                                <Label text="Additional preference for AI recommendation (optional)" styleClass="text-muted"/>
                                <TextArea fx:id="aiJobPreferenceField" wrapText="true" prefRowCount="3"/>
                                <Button text="AI Recommend Jobs" onAction="#handleAiRecommendJobs" maxWidth="Infinity"/>
                                <Label text="AI Job Recommendations" styleClass="text-muted"/>
                                <TextArea fx:id="aiJobRecommendationArea" editable="false" wrapText="true" VBox.vgrow="ALWAYS"/>
                            </VBox>
                        </SplitPane>
                    </center>
                </BorderPane>
            </Tab>
            <Tab fx:id="myProfileTab" text="My profile">
                <BorderPane>
                    <top>
                        <HBox spacing="10" alignment="CENTER_RIGHT" styleClass="p-3">
                            <Button text="Change Password" onAction="#handleChangePasswordFromProfile" styleClass="btn-outline"/>
                        </HBox>
                    </top>
                    <center>
                        <ScrollPane fitToWidth="true" hbarPolicy="NEVER">
                            <HBox alignment="TOP_CENTER">
                                <VBox spacing="20" styleClass="p-4" maxWidth="750" minWidth="600" HBox.hgrow="NEVER">
                                <!-- Account Info Section -->
                                <VBox spacing="12" styleClass="form-section">
                                    <Label text="Account Information" styleClass="h6"/>

                                    <GridPane hgap="20" vgap="12">
                                        <columnConstraints>
                                            <ColumnConstraints minWidth="120" maxWidth="150" prefWidth="130"/>
                                            <ColumnConstraints hgrow="ALWAYS"/>
                                        </columnConstraints>

                                        <Label text="Email" GridPane.rowIndex="0" styleClass="form-label"/>
                                        <TextField fx:id="emailField" editable="false" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                                        <Label text="Full name" GridPane.rowIndex="1" styleClass="form-label"/>
                                        <TextField fx:id="fullNameField" promptText="Shown in welcome message" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                                        <Label text="Phone" GridPane.rowIndex="2" styleClass="form-label"/>
                                        <TextField fx:id="phoneField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                                        <Label text="Major" GridPane.rowIndex="3" styleClass="form-label"/>
                                        <TextField fx:id="majorField" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                                    </GridPane>
                                </VBox>

                                <!-- Professional Info Section -->
                                <VBox spacing="12" styleClass="form-section">
                                    <Label text="Professional Information" styleClass="h6"/>

                                    <VBox spacing="8">
                                        <Label text="Skills" styleClass="form-label"/>
                                        <TextArea fx:id="skillsArea" wrapText="true" prefRowCount="3" promptText="List your technical skills"/>

                                        <Label text="Experience" styleClass="form-label"/>
                                        <TextArea fx:id="experienceArea" wrapText="true" prefRowCount="4" promptText="Describe your relevant experience"/>

                                        <Label text="Self evaluation" styleClass="form-label"/>
                                        <TextArea fx:id="selfEvalArea" wrapText="true" prefRowCount="4" promptText="Tell us about yourself"/>
                                    </VBox>
                                </VBox>

                                <!-- CV Section -->
                                <VBox spacing="12" styleClass="form-section">
                                    <Label text="Resume / CV" styleClass="h6"/>

                                    <VBox spacing="8">
                                        <HBox spacing="10" alignment="CENTER_LEFT">
                                            <Label fx:id="cvPathLabel" text="No CV uploaded" styleClass="text-muted"/>
                                            <Region HBox.hgrow="ALWAYS"/>
                                            <Button fx:id="downloadCvButton" text="Download CV" onAction="#handleDownloadCv"
                                                    styleClass="btn-sm btn-outline" visible="false" managed="false"/>
                                        </HBox>
                                        <HBox spacing="10">
                                            <Button text="Upload CV (TXT)" onAction="#handleUploadCv" styleClass="btn-outline"/>
                                            <Button text="AI Fill Profile from CV" onAction="#handleAiFillProfileFromCv" styleClass="btn-sm"/>
                                        </HBox>
                                        <Label fx:id="aiFillStatusLabel" text="" styleClass="text-muted"/>
                                    </VBox>
                                </VBox>

                                <!-- Action Buttons -->
                                <HBox spacing="10" alignment="CENTER">
                                    <Button text="Save profile" onAction="#handleSaveProfile" styleClass="btn-primary"/>
                                </HBox>
                                </VBox>
                            </HBox>
                        </ScrollPane>
                    </center>
                </BorderPane>
            </Tab>
        </TabPane>
    </center>
</BorderPane>
